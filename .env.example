# Fill in ONE of the API keys below and leave the other one empty.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional. Leave empty to auto-detect the provider from the key above
# (or set it to "openai" or "anthropic" to force one).
LLM_PROVIDER=
# Optional: model name. Defaults: gpt-4o-mini (openai), claude-sonnet-5-5 (anthropic)
LLM_MODEL=
# Optional: base URL for OpenAI-compatible services such as Groq or Gemini
LLM_BASE_URL=
# Optional: reasoning effort for models that support it (low, medium, high)
LLM_REASONING_EFFORT=
# Optional: minimum seconds between LLM requests (default 1)
LLM_MIN_INTERVAL=
