# Choose one provider: openai or anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
# Optional: model name (defaults: gpt-4o-mini for openai, claude-sonnet-5-5 for anthropic)
LLM_MODEL=
# Optional: base URL for OpenAI-compatible services (Gemini, Groq, ...)
LLM_BASE_URL=
